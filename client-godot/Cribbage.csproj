<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>Cribbage</RootNamespace>
    <Nullable>enable</Nullable>
    <!-- Run on whichever .NET runtime is installed (8 or later). -->
    <RollForward>LatestMajor</RollForward>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.36.1" />
    <PackageReference Include="Grpc.Tools" Version="2.84.0" PrivateAssets="all" />
    <!-- C# classes for the shared schema, generated at build time. -->
    <Protobuf Include="../proto/cribbage/v1/cribbage.proto" ProtoRoot="../proto" GrpcServices="None" />
  </ItemGroup>
  <!-- Release builds (export.sh) name their default server and version
       through the environment; BuildInfo reads them back. -->
  <ItemGroup>
    <AssemblyMetadata Include="CribbageServer" Value="$(CRIBBAGE_DEFAULT_SERVER)" Condition="'$(CRIBBAGE_DEFAULT_SERVER)' != ''" />
    <AssemblyMetadata Include="CribbageVersion" Value="$(CRIBBAGE_VERSION)" Condition="'$(CRIBBAGE_VERSION)' != ''" />
  </ItemGroup>
</Project>
