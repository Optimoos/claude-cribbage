# Caddy terminates HTTPS (certificates from Let's Encrypt, renewed
# automatically) and proxies the web client, /api and the /rtc signaling
# WebSocket to the server on localhost. WebRTC game traffic does not pass
# through Caddy: it goes straight to the server on UDP 7778.
#
# Replace the domain; its DNS A/AAAA records must point at this machine.
cribbage.example.com {
	encode zstd gzip
	reverse_proxy 127.0.0.1:8080

	# The server sets Content-Security-Policy itself.
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
	}
}
