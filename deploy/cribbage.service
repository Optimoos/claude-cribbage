# systemd unit for the cribbage server. Install as
# /etc/systemd/system/cribbage.service (see README.md).
[Unit]
Description=Cribbage game server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cribbage
Group=cribbage
WorkingDirectory=/var/lib/cribbage
# Settings are in /etc/cribbage/cribserver.conf (deploy/cribserver.conf).
ExecStart=/opt/cribbage/cribserver -config /etc/cribbage/cribserver.conf
# Secrets (see README.md): /etc/cribbage/smtp-password and
# /etc/cribbage/email-key, mode 0600, owned by root. systemd hands them to
# the server; cribserver.conf names them.
LoadCredential=smtp-password:/etc/cribbage/smtp-password
LoadCredential=email-key:/etc/cribbage/email-key
#LoadCredential=bot-key:/etc/cribbage/bot-key
# /run/cribbage holds the admin socket (cribserver admin ...).
RuntimeDirectory=cribbage
RuntimeDirectoryMode=0700
Restart=always
RestartSec=2
TimeoutStopSec=15

# Hardening: the server needs only its data directory and the network.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ReadWritePaths=/var/lib/cribbage
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# Only to listen on port 443.
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
RestrictSUIDSGID=true
RestrictRealtime=true
RemoveIPC=true
ProtectClock=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectProc=invisible
ProcSubset=pid
UMask=0077

# Resource limits, so a runaway server cannot take sshd down
# with it. For a 2 GB machine; scale MemoryMax and GOMEMLIMIT together
# (GOMEMLIMIT a little lower, so Go collects garbage before systemd kills).
Environment=GOMEMLIMIT=1100MiB
MemoryHigh=1200M
MemoryMax=1400M
TasksMax=512
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
