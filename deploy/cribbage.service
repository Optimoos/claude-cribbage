# systemd unit for the cribbage server. Install as
# /etc/systemd/system/cribbage.service (see README.md).
[Unit]
Description=Cribbage game server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cribbage
Group=cribbage
WorkingDirectory=/var/lib/cribbage
# HTTP and the bot TCP port listen on localhost only: Caddy serves HTTPS,
# and only WebRTC (UDP 7778) faces the internet. Add
# -public-ip <address> on clouds whose public IP is NATed (AWS, GCP, Azure).
ExecStart=/opt/cribbage/cribserver \
	-http 127.0.0.1:8080 \
	-tcp 127.0.0.1:7777 \
	-rtc-port 7778 -rtc-public-only \
	-db /var/lib/cribbage/cribbage.db \
	-backup-dir /var/lib/cribbage/backups \
	-backup-every 24h -backup-keep 7 \
	-expert /opt/cribbage/expert.bin \
	-admin-socket /run/cribbage/admin.sock \
	-stats 5m
# Password reset emails (see README.md): add these flags to ExecStart
# above, with your values, uncomment LoadCredential, and create
# /etc/cribbage/smtp-password (mode 0600, owned by root).
#	-public-url https://cribbage.example.com \
#	-smtp smtp.example.com:465 -smtp-user cribbage@example.com \
#	-smtp-password-file %d/smtp-password \
#	-mail-from cribbage@example.com
#LoadCredential=smtp-password:/etc/cribbage/smtp-password
# /run/cribbage holds the admin socket (cribserver admin ...).
RuntimeDirectory=cribbage
RuntimeDirectoryMode=0700
Restart=always
RestartSec=2
TimeoutStopSec=15

# Hardening: the server needs only its data directory and the network.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ReadWritePaths=/var/lib/cribbage
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
AmbientCapabilities=
RestrictSUIDSGID=true
RestrictRealtime=true
RemoveIPC=true
ProtectClock=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectProc=invisible
ProcSubset=pid
UMask=0077

# Resource limits, so a runaway server cannot take Caddy and sshd down
# with it. For a 2 GB machine; scale MemoryMax and GOMEMLIMIT together
# (GOMEMLIMIT a little lower, so Go collects garbage before systemd kills).
Environment=GOMEMLIMIT=1100MiB
MemoryHigh=1200M
MemoryMax=1400M
TasksMax=512
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
